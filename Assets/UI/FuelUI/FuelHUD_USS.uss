/* Ana Konteyner: Sağ alta sabitleyen ve hizalayan alan */
.fuel-container {
    position: absolute;
    bottom: 40px;
    right: 40px;
    flex-direction: row;
    align-items: center;
}

/* Barın arka planı (Koyu gri çerçeveli) */
.fuel-background {
    width: 250px;
    height: 20px;
    background-color: rgba(20, 20, 20, 0.85);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.5);
    overflow: hidden;
    justify-content: center;
    padding-left: 2px;
    padding-right: 2px;
}

/* Dolum Barı: Animasyonlu (Turuncu) */
.fuel-fill {
    width: 100%;
    height: 16px;
    background-color: rgb(255, 150, 0);
    border-radius: 8px;
    transition-duration: 0.2s; /* Pürüzsüz dolma/azalma animasyonu */
}

/* Sağ taraftaki yakıt ikonu (Emoji) ve gölge efekti */
.fuel-icon {
    font-size: 30px;
    margin-left: 12px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}
.hud-container {
    position: absolute;
    bottom: 30px;
    right: 30px;
    width: 320px;
    min-height: 70px; /* height yerine min-height yaptık ki 2. bar gelince uzasın */
    background-color: rgba(15, 15, 18, 0.85);
    border-radius: 12px;
    border-left-width: 5px;
    border-left-color: rgb(255, 140, 0);
    flex-direction: column; /* row yerine column yaptık ki alt alta gelsinler */
    justify-content: center;
    padding: 10px 15px;
    transition-property: border-left-color;
    transition-duration: 0.3s;
}
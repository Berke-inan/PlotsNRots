/* Ana Konteyner: Minimalist, yarı saydam, sol tarafında vurgu çizgisi olan panel */
.hud-container {
    position: absolute;
    bottom: 30px;
    right: 30px;
    width: 320px;
    height: 70px;
    background-color: rgba(15, 15, 18, 0.85); /* Koyu mat arka plan */
    border-radius: 12px;
    border-left-width: 5px;
    border-left-color: rgb(255, 140, 0); /* Turuncu vurgu çizgisi */
    flex-direction: row;
    align-items: center;
    padding: 10px 15px;
    transition-property: border-left-color; /* Renk değişimi animasyonlu olsun */
    transition-duration: 0.3s;
}

/* Sol taraftaki Emojinin/İkonun kutusu */
.icon-container {
    justify-content: center;
    align-items: center;
    margin-right: 15px;
}

.fuel-icon {
    font-size: 28px;
    color: rgb(230, 230, 230);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

/* Yazı ve Barı tutan sağ taraf */
.bar-container {
    flex-grow: 1;
    justify-content: center;
}

/* YAKIT ve %100 Yazıları */
.hud-title {
    color: rgb(220, 220, 220);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    letter-spacing: 2px;
}

/* Barın Koyu Arka Planı */
.progress-bg {
    height: 10px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 5px;
    overflow: hidden;
}

/* Turuncu Doldurma Barı (Pürüzsüz kayma efekti eklendi) */
.progress-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(255, 140, 0);
    border-radius: 5px;
    transition-property: width, background-color;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic; /* Gerçekçi frenli kayma efekti */
}

/* --- KRİTİK SEVİYE DURUMLARI (%20'nin altına inince devreye girecek) --- */
.progress-fill-low {
    background-color: rgb(220, 40, 40); /* Kırmızı */
}

.hud-container-low {
    border-left-color: rgb(220, 40, 40); /* Kutu çizgisi de Kırmızı olsun */
}
/* Ana Konteyner (Çift barı destekleyen yapı) */
.hud-container {
    position: absolute;
    bottom: 30px;
    right: 30px;
    width: 320px;
    min-height: 70px; 
    background-color: rgba(15, 15, 18, 0.85);
    border-radius: 12px;
    border-left-width: 5px;
    border-left-color: rgb(255, 140, 0);
    flex-direction: column; 
    justify-content: center;
    padding: 10px 15px;
    transition-property: border-left-color;
    transition-duration: 0.3s;
}

/* Emojilerin/İkonların kutusu */
.icon-container {
    justify-content: center;
    align-items: center;
    margin-right: 15px;
}

.fuel-icon {
    font-size: 28px;
    color: rgb(230, 230, 230);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

/* Yazı ve Barı tutan sağ taraf */
.bar-container {
    flex-grow: 1;
    justify-content: center;
}

/* Başlık ve Yüzde Yazıları */
.hud-title {
    color: rgb(220, 220, 220);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    letter-spacing: 2px;
}

/* Barın Koyu Arka Planı */
.progress-bg {
    height: 10px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 5px;
    overflow: hidden;
}

/* İçini Dolduran Renkli Bar (Yumuşak animasyonlu) */
.progress-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(255, 140, 0);
    border-radius: 5px;
    transition-property: width, background-color;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}

/* KRİTİK SEVİYE UYARILARI (%20'nin altına inince devreye girer) */
.progress-fill-low {
    background-color: rgb(220, 40, 40); 
}

.hud-container-low {
    border-left-color: rgb(220, 40, 40); 
}
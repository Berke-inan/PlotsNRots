#pragma kernel CSMain

struct ParticleData
{
    float3 position;
    float3 velocity;
    float seed;
    float age;
};

RWStructuredBuffer<ParticleData> _Particles;
StructuredBuffer<float4> _CollisionCells;

int _ParticleCount;

float3 _Anchor;
float4 _HorizontalRadius;

float _Above;
float _Below;

float3 _Wind;

float2 _TravelDirectionXZ;
float _FastSnowRefill;
float _FastSnowBelowCameraSpawnFraction;
float _FastSnowVerticalLowBias;
float _FastSnowBackSpawnFraction;
float _FastSnowRecycleBehindDistance;
float3 _CameraPositionWS;

float _FallSpeed;
float _Turbulence;
float _DeltaTime;
float _TimeValue;

int _Mode;
int _RespawnAll;
int _FrameSeed;


// ============================================================
// WORLD COLLISION FIELD
// ============================================================

int _CollisionEnabled;
int _CollisionGridResolution;

float3 _CollisionOrigin;

float _CollisionCellSize;
float _CollisionSurfacePadding;


// ============================================================
// RANDOM
// ============================================================

float Hash11(float value)
{
    return frac(
        sin(
            value * 12.9898
            +
            78.233)
        *
        43758.5453);
}

float3 Hash31(float value)
{
    return float3(
        Hash11(value + 1.13),
        Hash11(value + 17.71),
        Hash11(value + 43.37));
}


// ============================================================
// RESPAWN
// ============================================================

void Respawn(
    uint id,
    inout ParticleData particle)
{
    particle.seed =
        frac(
            particle.seed
            +
            0.6180339887
            +
            id * 0.000013
            +
            _FrameSeed * 0.000001);

    float3 randomValue =
        Hash31(
            particle.seed * 997.0
            +
            id * 0.173
            +
            _FrameSeed * 0.019);

    float fastRefill =
        (_Mode == 1)

            ?
            saturate(
                _FastSnowRefill)

            :
            0.0;

    float2 travelDirection =
        _TravelDirectionXZ;

    float travelLengthSq =
        dot(
            travelDirection,
            travelDirection);

    float2 horizontalOffset;

    if (fastRefill > 0.0001
        &&
        travelLengthSq > 0.0001)
    {
        travelDirection *=
            rsqrt(
                travelLengthSq);

        float2 right =
            float2(
                -travelDirection.y,
                travelDirection.x);

        float usableRadius =
            max(
                1.0,
                min(
                    _HorizontalRadius.x,
                    _HorizontalRadius.y));

        float backFraction =
            lerp(
                1.0,
                saturate(
                    _FastSnowBackSpawnFraction),
                fastRefill);

        float forwardDistance =
            lerp(
                -usableRadius * backFraction,
                usableRadius,
                randomValue.z);

        float sideDistance =
            lerp(
                -usableRadius,
                usableRadius,
                randomValue.x);

        horizontalOffset =
            travelDirection * forwardDistance
            +
            right * sideDistance;

        horizontalOffset =
            clamp(
                horizontalOffset,
                -_HorizontalRadius.xy,
                _HorizontalRadius.xy);
    }
    else
    {
        horizontalOffset =
            float2(
                lerp(
                    -_HorizontalRadius.x,
                    _HorizontalRadius.x,
                    randomValue.x),

                lerp(
                    -_HorizontalRadius.y,
                    _HorizontalRadius.y,
                    randomValue.z));
    }

    float normalMinimumHeight =
        _Above * 0.58;

    // At speed, the vehicle is entering snow that already existed in the world.
    // Recycled flakes therefore fill the vertical volume instead of all starting
    // high above the camera and needing several seconds to reach road level.
    float fastMinimumHeight =
        -_Below
        *
        clamp(
            _FastSnowBelowCameraSpawnFraction,
            0.0,
            0.45);

    float minimumSpawnHeight =
        lerp(
            normalMinimumHeight,
            fastMinimumHeight,
            fastRefill);

    float lowBias =
        max(
            1.0,
            _FastSnowVerticalLowBias);

    float fastVerticalRandom =
        pow(
            saturate(
                randomValue.y),
            lowBias);

    float verticalRandom =
        lerp(
            randomValue.y,
            fastVerticalRandom,
            fastRefill);

    particle.position =
        _Anchor
        +
        float3(
            horizontalOffset.x,

            lerp(
                minimumSpawnHeight,
                _Above,
                verticalRandom),

            horizontalOffset.y);

    float fallVariation =
        lerp(
            0.86,
            1.16,
            Hash11(
                particle.seed
                *
                123.7));

    particle.velocity =
        float3(
            _Wind.x,

            -_FallSpeed
            *
            fallVariation,

            _Wind.z);

    float verticalTravel =
        max(
            1.0,
            particle.position.y
            -
            (_Anchor.y - _Below));

    particle.age =
        verticalTravel
        /
        max(
            0.1,
            abs(
                particle.velocity.y))
        *
        lerp(
            0.9,
            1.25,
            Hash11(
                particle.seed
                *
                331.1));
}


// ============================================================
// COLLISION LOOKUP
// ============================================================

// The CPU samples one vertical ray at the centre of each collision cell.
// A raw height lookup is too coarse for sloped roofs: one side of a cell can
// be visibly higher than the sampled centre and flakes can appear to sink
// through the roof before the collision test catches them.
//
// Each cell already stores the hit normal, so reconstruct the local surface
// plane at the particle XZ position. This keeps the CPU ray budget unchanged
// while making pitched roofs much more accurate.
bool TryGetCollisionHeight(
    float2 worldXZ,
    out float surfaceHeight,
    out float3 surfaceNormal)
{
    surfaceHeight =
        -100000.0;

    surfaceNormal =
        float3(
            0.0,
            1.0,
            0.0);

    if (_CollisionEnabled == 0
        ||
        _CollisionGridResolution <= 0
        ||
        _CollisionCellSize <= 0.0)
    {
        return false;
    }

    float2 relative =
        (
            worldXZ
            -
            _CollisionOrigin.xz
        )
        /
        _CollisionCellSize;

    int2 cell =
        int2(
            floor(relative));

    if (cell.x < 0
        ||
        cell.y < 0
        ||
        cell.x
            >=
            _CollisionGridResolution
        ||
        cell.y
            >=
            _CollisionGridResolution)
    {
        return false;
    }

    int index =
        cell.y
        *
        _CollisionGridResolution
        +
        cell.x;

    float4 surface =
        _CollisionCells[index];

    if (surface.x
        <=
        -9999.0)
    {
        return false;
    }

    surfaceNormal =
        surface.yzw;

    float normalLengthSquared =
        dot(
            surfaceNormal,
            surfaceNormal);

    if (normalLengthSquared
        >
        0.000001)
    {
        surfaceNormal *=
            rsqrt(
                normalLengthSquared);
    }
    else
    {
        surfaceNormal =
            float3(
                0.0,
                1.0,
                0.0);
    }

    // Collision rays are cast from above, so use an upward-facing plane even
    // when an imported collider happens to report a flipped triangle normal.
    if (surfaceNormal.y
        <
        0.0)
    {
        surfaceNormal =
            -surfaceNormal;
    }

    surfaceHeight =
        surface.x;

    // Reconstruct the sloped plane only when it has a useful vertical
    // component. Nearly vertical hits can occur on edges and are safer as a
    // simple sampled height.
    if (surfaceNormal.y
        >
        0.08)
    {
        float2 cellCentreXZ =
            _CollisionOrigin.xz
            +
            (
                float2(
                    cell)
                +
                0.5
            )
            *
            _CollisionCellSize;

        float2 horizontalDelta =
            worldXZ
            -
            cellCentreXZ;

        float projectedHeight =
            surface.x
            -
            dot(
                surfaceNormal.xz,
                horizontalDelta)
            /
            surfaceNormal.y;

        // Guard against pathological edge normals creating an extreme plane.
        float maximumProjection =
            _CollisionCellSize
            *
            1.5;

        surfaceHeight =
            clamp(
                projectedHeight,
                surface.x
                    -
                    maximumProjection,
                surface.x
                    +
                    maximumProjection);
    }

    surfaceHeight +=
        _CollisionSurfacePadding;

    return true;
}


bool IsAtOrBelowCollisionSurface(
    float3 worldPosition)
{
    float surfaceHeight;
    float3 surfaceNormal;

    if (!TryGetCollisionHeight(
            worldPosition.xz,
            surfaceHeight,
            surfaceNormal))
    {
        return false;
    }

    return
        worldPosition.y
        <=
        surfaceHeight;
}


// Test the current position, the midpoint and the next position.
// The midpoint closes the remaining gap for fast rain or strong storm wind
// without adding any CPU physics queries.
bool CrossesCollisionSurface(
    float3 currentPosition,
    float3 nextPosition)
{
    if (IsAtOrBelowCollisionSurface(
            currentPosition))
    {
        return true;
    }

    float3 midpoint =
        (
            currentPosition
            +
            nextPosition
        )
        *
        0.5;

    if (IsAtOrBelowCollisionSurface(
            midpoint))
    {
        return true;
    }

    return
        IsAtOrBelowCollisionSurface(
            nextPosition);
}


// ============================================================
// SIMULATION
// ============================================================

[numthreads(256, 1, 1)]
void CSMain(
    uint3 dispatchId
        :
        SV_DispatchThreadID)
{
    uint id =
        dispatchId.x;

    if (id
        >=
        (uint) _ParticleCount)
    {
        return;
    }

    ParticleData particle =
        _Particles[id];

    float3 relative =
        particle.position
        -
        _Anchor;

    bool outside =
        abs(relative.x)
            >
            _HorizontalRadius.x
        ||
        abs(relative.z)
            >
            _HorizontalRadius.y
        ||
        relative.y
            <
            -_Below
        ||
        relative.y
            >
            _Above * 1.25;

    // At high speed, snow left far behind the camera no longer contributes to
    // the view. Recycle only those flakes so the same particle budget stays
    // useful ahead of the vehicle. Their physical velocity is not altered.
    if (!outside
        &&
        _Mode == 1
        &&
        _FastSnowRefill > 0.0001)
    {
        float2 travelDirection =
            _TravelDirectionXZ;

        float travelLengthSq =
            dot(
                travelDirection,
                travelDirection);

        if (travelLengthSq > 0.0001)
        {
            travelDirection *=
                rsqrt(
                    travelLengthSq);

            float behind =
                dot(
                    particle.position.xz
                    -
                    _CameraPositionWS.xz,
                    travelDirection);

            float normalBehindDistance =
                max(
                    _HorizontalRadius.x,
                    _HorizontalRadius.y);

            float recycleBehindDistance =
                lerp(
                    normalBehindDistance,
                    max(
                        2.0,
                        _FastSnowRecycleBehindDistance),
                    saturate(
                        _FastSnowRefill));

            outside =
                behind
                <
                -recycleBehindDistance;
        }
    }

    if (_RespawnAll != 0
        ||
        particle.age <= 0.0
        ||
        outside)
    {
        Respawn(
            id,
            particle);

        _Particles[id] =
            particle;

        return;
    }


    // ========================================================
    // RAIN
    // ========================================================

    if (_Mode == 0)
    {
        float variance =
            lerp(
                0.9,
                1.1,
                Hash11(
                    particle.seed
                    *
                    61.3));

        particle.velocity.xz =
            _Wind.xz
            *
            variance;

        particle.velocity.y =
            -_FallSpeed
            *
            lerp(
                0.9,
                1.12,
                Hash11(
                    particle.seed
                    *
                    95.7));
    }

    // ========================================================
    // SNOW
    // ========================================================
    else
    {
        float phase =
            _TimeValue
            *
            lerp(
                0.9,
                1.55,
                Hash11(
                    particle.seed
                    *
                    19.9))
            +
            particle.seed
            *
            31.0;

        float2 swirl =
            float2(
                sin(
                    phase
                    +
                    particle.position.z
                    *
                    0.065),

                cos(
                    phase * 0.83
                    +
                    particle.position.x
                    *
                    0.071))
            *
            _Turbulence;

        particle.velocity.xz =
            _Wind.xz
            +
            swirl;

        particle.velocity.y =
            -_FallSpeed
            *
            lerp(
                0.78,
                1.18,
                Hash11(
                    particle.seed
                    *
                    71.1));
    }


    // ========================================================
    // NEXT POSITION
    // ========================================================

    float3 nextPosition =
        particle.position
        +
        particle.velocity
        *
        _DeltaTime;


    // ========================================================
    // WORLD COLLISION
    // ========================================================

    // Rain/snow may not continue below terrain, roofs or other detected
    // collision surfaces. Current-position testing also removes particles that
    // were already below a roof when the height field refreshed.
    if (CrossesCollisionSurface(
            particle.position,
            nextPosition))
    {
        Respawn(
            id,
            particle);

        _Particles[id] =
            particle;

        return;
    }


    // ========================================================
    // FINISH
    // ========================================================

    particle.position =
        nextPosition;

    particle.age -=
        _DeltaTime;

    _Particles[id] =
        particle;
}